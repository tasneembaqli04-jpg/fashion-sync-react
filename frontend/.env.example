# Copy this file to .env and fill in the deployed function URLs.
#
#   cp .env.example .env
#
# Each value is the trigger URL of the matching cloud function. Replace
# REGION and PROJECT_ID with your own; the function names are already
# correct and match the exports in backend/src/index.js.
#
# .env is gitignored and must never be committed. To run against the local
# emulator instead, use npm run dev:emulator, which loads .env.emulator.
VITE_EMAIL_URL=https://REGION-PROJECT_ID.cloudfunctions.net/sendOrderEmail
VITE_STOCK_ALERT_EMAIL_URL=https://REGION-PROJECT_ID.cloudfunctions.net/sendStockAlertEmail
VITE_SHIPPING_UPDATE_EMAIL_URL=https://REGION-PROJECT_ID.cloudfunctions.net/sendShippingUpdateEmail
VITE_WELCOME_EMAIL_URL=https://REGION-PROJECT_ID.cloudfunctions.net/sendWelcomeEmail
VITE_RETURN_STATUS_EMAIL_URL=https://REGION-PROJECT_ID.cloudfunctions.net/sendReturnStatusEmail
VITE_CONTACT_NOTIFICATION_EMAIL_URL=https://REGION-PROJECT_ID.cloudfunctions.net/sendContactNotificationEmail
VITE_PASSWORD_RESET_EMAIL_URL=https://REGION-PROJECT_ID.cloudfunctions.net/sendPasswordResetEmail
VITE_VERIFICATION_EMAIL_URL=https://REGION-PROJECT_ID.cloudfunctions.net/sendVerificationEmail
VITE_ORDER_CANCELLATION_EMAIL_URL=https://REGION-PROJECT_ID.cloudfunctions.net/sendOrderCancellationEmail
VITE_PICKUP_SCHEDULED_EMAIL_URL=https://REGION-PROJECT_ID.cloudfunctions.net/sendPickupScheduledEmail
VITE_CHAT_URL=https://REGION-PROJECT_ID.cloudfunctions.net/chat
VITE_TRY_ON_URL=https://REGION-PROJECT_ID.cloudfunctions.net/tryOn
VITE_TRY_ON_V2_URL=https://REGION-PROJECT_ID.cloudfunctions.net/tryOnV2
VITE_ORDER_REJECTED_EMAIL_URL=https://REGION-PROJECT_ID.cloudfunctions.net/sendOrderRejectedEmail
VITE_GIFT_CARD_REJECTED_EMAIL_URL=https://REGION-PROJECT_ID.cloudfunctions.net/sendGiftCardRejectedEmail
VITE_GIFT_CARD_ACTIVATED_EMAIL_URL=https://REGION-PROJECT_ID.cloudfunctions.net/sendGiftCardActivatedEmail

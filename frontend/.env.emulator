# Function URLs for the local Firebase Functions emulator.
#
# Loaded only when running in emulator mode:
#   npm run dev:emulator
#
# A normal run (npm run dev) ignores this file entirely and uses .env,
# which holds the deployed cloud URLs.
#
# The function names come from module.exports in backend/src/index.js.
# Renaming a function there means renaming it here too.
#
# Port 5001 is the functions emulator default. firebase.json declares no
# emulators block, so nothing overrides it.
#
# This file is committed on purpose: it contains only localhost addresses,
# so a fresh clone can run against the emulator without rebuilding the URLs.
VITE_EMAIL_URL=http://127.0.0.1:5001/fashionsync-dc79f/us-central1/sendOrderEmail
VITE_STOCK_ALERT_EMAIL_URL=http://127.0.0.1:5001/fashionsync-dc79f/us-central1/sendStockAlertEmail
VITE_SHIPPING_UPDATE_EMAIL_URL=http://127.0.0.1:5001/fashionsync-dc79f/us-central1/sendShippingUpdateEmail
VITE_WELCOME_EMAIL_URL=http://127.0.0.1:5001/fashionsync-dc79f/us-central1/sendWelcomeEmail
VITE_RETURN_STATUS_EMAIL_URL=http://127.0.0.1:5001/fashionsync-dc79f/us-central1/sendReturnStatusEmail
VITE_CONTACT_NOTIFICATION_EMAIL_URL=http://127.0.0.1:5001/fashionsync-dc79f/us-central1/sendContactNotificationEmail
VITE_PASSWORD_RESET_EMAIL_URL=http://127.0.0.1:5001/fashionsync-dc79f/us-central1/sendPasswordResetEmail
VITE_VERIFICATION_EMAIL_URL=http://127.0.0.1:5001/fashionsync-dc79f/us-central1/sendVerificationEmail
VITE_ORDER_CANCELLATION_EMAIL_URL=http://127.0.0.1:5001/fashionsync-dc79f/us-central1/sendOrderCancellationEmail
VITE_PICKUP_SCHEDULED_EMAIL_URL=http://127.0.0.1:5001/fashionsync-dc79f/us-central1/sendPickupScheduledEmail
VITE_CHAT_URL=http://127.0.0.1:5001/fashionsync-dc79f/us-central1/chat
VITE_TRY_ON_URL=http://127.0.0.1:5001/fashionsync-dc79f/us-central1/tryOn

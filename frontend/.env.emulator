# כתובות הפונקציות באמולטור המקומי של Firebase Functions.
#
# הקובץ נטען רק בהרצה עם המצב emulator:
#   npm run dev:emulator
#
# בהרצה רגילה (npm run dev) הקובץ הזה מתעלם לחלוטין,
# ו-.env עם כתובות הענן הוא זה שקובע.
#
# שמות הפונקציות נלקחו מ-module.exports שב-backend/src/index.js.
# אם משנים שם של פונקציה שם — חובה לעדכן גם כאן.
#
# הפורט 5001 הוא ברירת המחדל של אמולטור הפונקציות.
# ב-firebase.json אין בלוק emulators שמגדיר פורט אחר.

VITE_EMAIL_URL=http://127.0.0.1:5001/fashionsync-dc79f/us-central1/sendOrderEmail
VITE_STOCK_ALERT_EMAIL_URL=http://127.0.0.1:5001/fashionsync-dc79f/us-central1/sendStockAlertEmail

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isManager() {
      return request.auth != null &&
             request.auth.token.email.lower() == "manager@fashionsync-internal.com";
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(email) {
      return isSignedIn() && request.auth.token.email.lower() == email.lower();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isManager();
      allow update: if isManager() ||
                       (isSignedIn() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(["stock", "variants", "salesLastMonth"]));
    }

    match /orders/{orderId} {
      allow read: if isManager() ||
                     (isSignedIn() && resource.data.customerEmail == request.auth.token.email.lower());
      allow create: if isSignedIn() &&
                       request.resource.data.customerEmail == request.auth.token.email.lower();
      // Customers update orders through exactly two flows in ordersService:
      // cancelOrder writes cancelled/cancelledAt, setPickupSchedule writes
      // pickupDate/pickupTime. Limiting to these four blocks total/status edits.
      allow update: if isManager() ||
                       (isSignedIn() &&
                        resource.data.customerEmail == request.auth.token.email.lower() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(["cancelled", "cancelledAt", "pickupDate", "pickupTime"]));

      // No code path lets a customer delete an order.
      allow delete: if isManager();
    }

    match /customers/{customerEmail} {
      // get = own document (getCustomer, getLoyaltyPoints).
      // list = whole collection; only Manager.jsx calls getAllCustomers.
      allow get: if isManager() || isOwner(customerEmail);
      allow list: if isManager();

      // INTENTIONALLY OPEN — do not tighten without a server-side replacement.
      // addLoyaltyPoints and redeemLoyaltyPoints still run in the browser
      // during checkout; restricting writes here breaks checkout immediately.
      allow write: if isManager() || isOwner(customerEmail);
    }

    match /carts/{customerEmail} {
      allow read, write: if isManager() || isOwner(customerEmail);
    }

    match /deliveries/{deliveryId} {
      allow read, write: if isManager();
    }

    match /wishlists/{email} {
      allow read, write: if isManager() || isOwner(email);
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isManager();
    }

    match /giftCards/{code} {
      // get = single card by code, needed by getGiftCard at checkout.
      // list = whole collection; manager only, so codes and balances
      // cannot be enumerated.
      allow get: if isSignedIn();
      allow list: if isManager();

      // INTENTIONALLY OPEN — do not tighten without a server-side replacement.
      // issueGiftCard and redeemGiftCardAmount still run in the browser during
      // checkout; restricting writes here breaks buying and paying with a card.
      allow create, update: if isManager() || isSignedIn();
      allow delete: if isManager();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isManager();
    }

    match /stockNotifications/{id} {
      allow create: if isSignedIn();
      allow read, update: if isManager() ||
                              (isSignedIn() && resource.data.email == request.auth.token.email.lower());
      allow delete: if isManager();
    }

    match /coupons/{code} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /couponUsage/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isManager();
    }

    match /returnRequests/{id} {
      allow create: if isSignedIn();
      allow read, update: if isManager() ||
                              (isSignedIn() && resource.data.customerEmail == request.auth.token.email.lower());
      allow delete: if isManager();
    }

    match /contactMessages/{id} {
      allow create: if true;
      allow read, update, delete: if isManager();
    }

    // Verification runs after signUp, so the user is already authenticated at
    // all three touch points (create code, resend, verify). Owner-only access
    // closes the public exposure; the code is still generated and checked in
    // the browser, so a full fix requires moving both to the server.
    match /emailVerifications/{email} {
      allow read, write: if isOwner(email);
    }
  }
}